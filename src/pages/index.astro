  .hi-typewriter {
    position: relative;
    display: inline-block;
    color: inherit;
    transition: color 0.3s ease;
  }

  .hi-typewriter.active {
    color: var(--accent);
  }

  .hi-ghost {
    opacity: 0.08;
    user-select: none;
  }

  .hi-text {
    position: absolute;
    left: 0;
    top: 0;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.1s forwards;
  }

  .bio {
