</style>

<script>
  // Typewriter effect for "hi" in Adhikari
  const hiTypewriter = document.querySelector('.hi-typewriter') as HTMLElement;
  const hiText = document.querySelector('.hi-text') as HTMLElement;
  const fullText = 'hi';
  let charIndex = fullText.length;
  let isGreen = false;

  function deleteChar() {
    if (charIndex > 0) {
      charIndex--;
      hiText.textContent = fullText.slice(0, charIndex);
      setTimeout(deleteChar, 100);
    } else {
      // After deleting, toggle color then type
      isGreen = !isGreen;
      if (isGreen) {
        hiTypewriter.classList.add('active');
      } else {
        hiTypewriter.classList.remove('active');
      }
      setTimeout(typeChar, 300);
    }
  }

  function typeChar() {
    if (charIndex < fullText.length) {
      charIndex++;
      hiText.textContent = fullText.slice(0, charIndex);
      setTimeout(typeChar, 150);
    } else {
      // Done typing, wait then delete again
      setTimeout(deleteChar, 2000);
    }
  }

  // Start cycle: wait 2s, then start deleting
  setTimeout(deleteChar, 2000);

  // Project filtering
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');
  const otherCards = document.querySelectorAll('.other-card');

  function filterItems(filter: string) {
    // Update active button
    filterBtns.forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-filter') === filter);
    });

    // Filter project cards
    projectCards.forEach(card => {
      const tech = card.getAttribute('data-tech');
      if (filter === 'all' || tech === filter) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });

    // Filter other cards
    otherCards.forEach(card => {
      const tech = card.getAttribute('data-tech');
      if (filter === 'all' || tech === filter) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });

    // Update URL hash
    if (filter === 'all') {
      history.replaceState(null, '', window.location.pathname);
    } else {
      history.replaceState(null, '', `#${filter}`);
    }
  }

  // Add click handlers
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'all';
      filterItems(filter);
    });
  });

  // Check URL hash on load
  const hash = window.location.hash.slice(1);
  if (hash && ['rust', 'typescript', 'python'].includes(hash)) {
    filterItems(hash);
  }

</script>
