  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--fg-dim);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0, 255, 136, 0.4); }
    50% { opacity: 0.8; box-shadow: 0 0 0 8px rgba(0, 255, 136, 0); }
  }

  /* Large screens */
  @media (max-width: 1200px) {
    main { max-width: 1000px; padding: 5rem 3rem; }
  }

  /* Tablets */
  @media (max-width: 900px) {
    main { padding: 4rem 2rem; }
    .hero { min-height: 60vh; }
    .project-grid { gap: 1rem; }
    h1 { font-size: clamp(2.5rem, 7vw, 4rem); }
  }

  /* Mobile */
  @media (max-width: 640px) {
    main { padding: 3rem 1.25rem; }
    .hero { min-height: 50vh; padding-bottom: 2rem; margin-bottom: 3rem; }
    .project-grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .project-info { padding: 1rem; }
    .project-card h3 { font-size: 1rem; }
    .project-card p { font-size: 0.75rem; }
    .links { gap: 1.5rem; }
