    background: rgba(255, 107, 107, 0.1);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .tech {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--accent);
    background: rgba(0, 255, 136, 0.15);
    padding: 0.25rem 0.6rem;
    border-radius: 50px;
  }


  .about-content { max-width: 700px; }

  .about-content p {
    font-size: 1.1rem;
    color: var(--fg-dim);
    margin-bottom: 2rem;
  }

  .stack {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .stack span {
