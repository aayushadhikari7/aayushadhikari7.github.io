  }

  .other-card:hover {
    border-color: var(--accent);
  }

  .other-info h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .other-info p {
    font-size: 0.8rem;
    color: var(--fg-dim);
    margin: 0;
  }

  .other-links {
    display: flex;
    gap: 0.75rem;
  }

  .other-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--fg-dim);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 50px;
    transition: all 0.2s;
  }

  .other-link:hover {
    border-color: var(--fg-dim);
    color: var(--fg);
  }

  .other-link.live {
    color: #ff6b6b;
    border-color: rgba(255, 107, 107, 0.3);
  }

  .other-link.live:hover {
    background: rgba(255, 107, 107, 0.1);
    border-color: #ff6b6b;
  }

  .other-link.download {
