  /* Contact card */
  .contact-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    max-width: 600px;
  }

  .contact-info p {
    color: var(--fg-dim);
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .contact-email {
    display: flex;
    align-items: center;
    gap: 0.75rem;
