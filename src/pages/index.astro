---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'aegis',
    description: 'webassembly sandbox runtime with capability-based security for running untrusted code safely',
    tech: 'rust',
    url: 'https://github.com/aayushadhikari7/aegis',
    image: '/projects/aegis.gif',
    gradient: 'linear-gradient(135deg, #1a1a2e 0%, #16213e 100%)'
  },
  {
    name: 'zaxiom',
    description: 'blazingly fast terminal for windows with 100+ commands, ai chat, splits, and 20+ themes',
    tech: 'rust',
    url: 'https://github.com/aayushadhikari7/zaxiom',
    image: '/projects/zaxiom.webp',
    gradient: 'linear-gradient(135deg, #0f0f0f 0%, #1a1a1a 100%)'
  },
  {
    name: 'what-changed',
    description: 'universal diff cli that explains what changed across 25+ file formats with risk scoring',
    tech: 'python',
    url: 'https://github.com/aayushadhikari7/what-changed',
    image: '/projects/what-changed.gif',
    gradient: 'linear-gradient(135deg, #1e3a2f 0%, #0d1f17 100%)'
  },
  {
    name: 'zammy-cli',
    description: 'all-in-one dev toolkit with 50+ utilities, productivity tools, and a friendly purple slime',
    tech: 'typescript',
    url: 'https://github.com/aayushadhikari7/zammy-cli',
    image: '/projects/zammy-cli.gif',
    gradient: 'linear-gradient(135deg, #2d1f3d 0%, #1a1225 100%)'
  },
  {
    name: 'bagh-chal',
    description: 'ancient nepali strategy game - 4 tigers vs 20 goats with p2p multiplayer',
    tech: 'typescript',
    url: 'https://github.com/aayushadhikari7/bagh-chal',
    live: 'https://bagh-chal-nine.vercel.app',
    image: '/projects/bagh-chal.webp',
    gradient: 'linear-gradient(135deg, #2d1f1f 0%, #1a1212 100%)'
  },
  {
    name: 'termgif',
    description: 'dead simple terminal gif recorder - write a script, get a beautiful gif',
    tech: 'python',
    url: 'https://github.com/aayushadhikari7/termgif',
    image: '/projects/termgif.gif',
    gradient: 'linear-gradient(135deg, #2d2d1f 0%, #1a1a12 100%)'
  }
];

const stack = ['rust', 'typescript', 'python', 'go', 'zig'];

const otherStuff = [
  {
    name: 'snakes & ladders 3d',
    description: 'fully interactive 3d board game with dice physics and fantasy characters',
    tech: 'typescript',
    live: 'https://snakes-and-ladders-mauve.vercel.app',
    url: 'https://github.com/aayushadhikari7/snakes-and-ladders'
  },
  {
    name: 'ninja edgerunners',
    description: 'naruto-themed 3d roguelite survival game',
    tech: 'typescript',
    live: 'https://ninja-edgerunners.vercel.app',
    url: 'https://github.com/aayushadhikari7/ninja-edgerunners-showcase'
  },
  {
    name: 'holo-drone',
    description: '3d drone flight simulation with realistic physics',
    tech: 'typescript',
    live: 'https://holo-drone.vercel.app/simulation',
    url: 'https://github.com/aayushadhikari7/holo-drone'
  },
  {
    name: 'rift warden',
    description: 'medieval fantasy tower defense game',
    tech: 'typescript',
    download: 'https://github.com/aayushadhikari7/rift-warden-releases/releases',
    url: 'https://github.com/aayushadhikari7/rift-warden-releases'
  }
];
---

<Layout title="Aayush Adhikari">
  <main>
    <section class="hero">
      <span class="label">hey, i'm</span>
      <h1>Aayush Ad<span class="hi-typewriter"><span class="hi-ghost">hi</span><span class="hi-text">hi</span></span>kari</h1>
      <p class="bio">
        i build tools, break things, and occasionally make games.<br/>
        currently into systems programming, security, and developer tooling.
      </p>
      <nav class="links">
        <a href="https://github.com/aayushadhikari7" target="_blank" rel="noopener noreferrer" class="link">
          <span>github</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
        <a href="mailto:aayushadkri+dev@gmail.com" class="link">
          <span>email</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
      </nav>
    </section>

    <section class="projects">
      <div class="section-header">
        <h2><span class="num">01</span> projects</h2>
        <div class="filters">
          <button class="filter-btn active" data-filter="all">all</button>
          <button class="filter-btn" data-filter="rust">rust</button>
          <button class="filter-btn" data-filter="typescript">typescript</button>
          <button class="filter-btn" data-filter="python">python</button>
        </div>
      </div>
      <div class="project-grid">
        {projects.map((p, i) => (
          <div class="project-card" data-tech={p.tech} style={`--i: ${i}; --gradient: ${p.gradient}`}>
            <img src={p.image} alt={p.name} class="project-bg" loading="lazy" />
            <div class="project-info">
              <div class="tags">
                <span class="tech">{p.tech}</span>
              </div>
              <div class="project-top">
                <h3>{p.name}</h3>
              </div>
              <p>{p.description}</p>
              <div class="project-links">
                <a href={p.url} class="proj-link">github ↗</a>
                {p.live && <a href={p.live} class="proj-link live">play ↗</a>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="about">
      <h2><span class="num">02</span> about</h2>
      <div class="about-content">
        <p>
          cs student who likes building things that solve actual problems.
          interested in systems programming, security research, and developer tooling.
        </p>
        <div class="stack">
          {stack.map(s => <span>{s}</span>)}
        </div>
      </div>
    </section>

    <section class="other">
      <h2><span class="num">03</span> other stuff</h2>
      <div class="other-grid">
        {otherStuff.map((item) => (
          <div class="other-card" data-tech={item.tech}>
            <div class="other-info">
              <span class="tech">{item.tech}</span>
              <h4>{item.name}</h4>
              <p>{item.description}</p>
            </div>
            <div class="other-links">
              {item.live && <a href={item.live} class="other-link live">play ↗</a>}
              {item.download && <a href={item.download} class="other-link download">download ↓</a>}
              <a href={item.url} class="other-link">github ↗</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="contact animate-on-scroll">
      <h2><span class="num">04</span> contact</h2>
      <div class="contact-card">
        <div class="contact-info">
          <p>have a project in mind or just want to chat?</p>
          <a href="mailto:aayushadkri+dev@gmail.com" class="contact-email">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span>aayushadkri+dev@gmail.com</span>
          </a>
        </div>
        <a href="mailto:aayushadkri+dev@gmail.com" class="contact-btn">
          send message
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
      </div>
    </section>

    <footer>
      <span>© 2026</span>
      <span class="status">
        <span class="dot"></span>
        available for internships
      </span>
    </footer>
  </main>
</Layout>

<style>
  main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 6rem 4rem;
    width: 100%;
  }

  .hero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 5rem;
  }

  .label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    opacity: 0;
    animation: fadeUp 0.6s ease forwards;
